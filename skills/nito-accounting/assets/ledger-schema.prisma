// Starter ledger schema for MariaDB/MySQL. A DESIGN, not a copy of any ERP:
// header-and-line entries as in Odoo, ERPNext and Oracle, a source reference on
// every entry, an idempotency key, and a counter row for numbering.
// See references/starter-implementation.md before using it.
//
// Prisma cannot declare CHECK constraints. Add the one in
// references/starter-implementation.md by raw SQL in the first migration.

datasource db {
  provider = "mysql"
}

enum AccAccountType {
  asset
  contra_asset
  liability
  equity
  contra_equity
  revenue
  contra_revenue
  expense
  temporary
  suspense
}

enum AccNormalBalance {
  debit
  credit
  either
}

enum AccEntryStatus {
  draft
  posted
  reversed
}

enum AccPeriodStatus {
  open
  closed
}

/// Chart of accounts. Loaded per company from a template; the engine reads
/// account_type and the flags, never the code.
model T_M_ACC_ACCOUNT {
  account_id     Int              @id @default(autoincrement())
  company_id     Int
  account_code   String           @db.VarChar(20)
  account_name   String           @db.VarChar(150)
  account_type   AccAccountType
  normal_balance AccNormalBalance
  parent_id      Int?
  is_postable    Boolean          @default(true)
  /// customer, supplier, item_and_location, asset_register; null when not a control account
  control_type   String?          @db.VarChar(30)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamp(0)

  lines    T_L_ACC_JOURNAL_LINE[]
  defaults T_M_ACC_DEFAULT_ACCOUNT[]

  @@unique([company_id, account_code], map: "uq_acc_account_code")
}

/// Account determination: role key (receivable, sales, tax_output_ppn ...) to account.
model T_M_ACC_DEFAULT_ACCOUNT {
  company_id Int
  role_key   String @db.VarChar(50)
  account_id Int

  account T_M_ACC_ACCOUNT @relation(fields: [account_id], references: [account_id])

  @@id([company_id, role_key])
}

/// Accounting periods. Posting into a closed period is refused by the service.
model T_M_ACC_PERIOD {
  period_id  Int             @id @default(autoincrement())
  company_id Int
  start_date DateTime        @db.Date
  end_date   DateTime        @db.Date
  status     AccPeriodStatus @default(open)

  @@unique([company_id, start_date], map: "uq_acc_period_start")
}

/// One row per company, journal and year. The posting transaction locks the
/// row with SELECT ... FOR UPDATE and increments it. AUTO_INCREMENT is not
/// used for document numbers because it leaves gaps after a rollback.
model T_M_ACC_SEQUENCE {
  company_id   Int
  journal_code String @db.VarChar(10)
  fiscal_year  Int
  next_number  Int    @default(1)

  @@id([company_id, journal_code, fiscal_year])
}

/// Journal entry header. Never updated after status = posted, except to mark
/// it reversed when its reversing entry is posted.
model T_L_ACC_JOURNAL_ENTRY {
  entry_id          BigInt         @id @default(autoincrement())
  company_id        Int
  journal_code      String         @db.VarChar(10)
  /// assigned at posting; null while draft (a unique index allows many nulls)
  entry_number      String?        @db.VarChar(30)
  status            AccEntryStatus @default(draft)
  posting_date      DateTime       @db.Date
  document_date     DateTime       @db.Date
  description       String?        @db.VarChar(255)
  /// the document that caused the posting; null only for a manual journal
  source_type       String?        @db.VarChar(40)
  source_id         String?        @db.VarChar(40)
  /// one per posting request, so a retry cannot post twice
  idempotency_key   String         @db.VarChar(80)
  reverses_entry_id BigInt?
  /// for receivable and payable entries: what the aging report reads
  due_date          DateTime?      @db.Date
  created_by        Int
  approved_by       Int?
  posted_at         DateTime?      @db.Timestamp(0)
  created_at        DateTime       @default(now()) @db.Timestamp(0)

  lines T_L_ACC_JOURNAL_LINE[]

  @@unique([company_id, idempotency_key], map: "uq_acc_entry_idem")
  @@unique([company_id, journal_code, entry_number], map: "uq_acc_entry_number")
  @@index([company_id, posting_date], map: "ix_acc_entry_date")
  @@index([source_type, source_id], map: "ix_acc_entry_source")
}

/// Journal entry line. Exactly one of debit and credit is above zero. Amounts
/// are in the functional currency; the transaction currency is kept beside them.
model T_L_ACC_JOURNAL_LINE {
  line_id         BigInt  @id @default(autoincrement())
  entry_id        BigInt
  line_no         Int
  account_id      Int
  debit           Decimal @default(0) @db.Decimal(18, 2)
  credit          Decimal @default(0) @db.Decimal(18, 2)
  currency_code   String  @default("IDR") @db.Char(3)
  amount_currency Decimal @default(0) @db.Decimal(18, 2)
  exchange_rate   Decimal @default(1) @db.Decimal(18, 8)
  /// customer, supplier, employee; required on control accounts
  party_type      String? @db.VarChar(20)
  party_id        Int?
  source_line_id  String? @db.VarChar(40)
  cost_center_id  Int?
  site_id         Int?
  project_id      Int?
  /// the operational object the line belongs to in the ERP that posted it:
  /// a voyage number, a shipment, a work order. Reports group by it.
  analytic_ref    String? @db.VarChar(40)
  description     String? @db.VarChar(255)

  entry   T_L_ACC_JOURNAL_ENTRY @relation(fields: [entry_id], references: [entry_id])
  account T_M_ACC_ACCOUNT       @relation(fields: [account_id], references: [account_id])
  debit_allocations  T_L_ACC_ALLOCATION[] @relation("alloc_debit")
  credit_allocations T_L_ACC_ALLOCATION[] @relation("alloc_credit")
  recon              T_L_ACC_BANK_RECON?

  @@unique([entry_id, line_no], map: "uq_acc_line_no")
  @@index([account_id], map: "ix_acc_line_account")
  @@index([party_type, party_id], map: "ix_acc_line_party")
  @@index([analytic_ref], map: "ix_acc_line_analytic")
}

// ---------------------------------------------------------------------------
// Beyond the ledger: what a working ERP needs around it. Same conventions.

enum AccCashbankKind {
  bank
  cash
}

/// Payment journals: one per bank account or cash box, each numbered on its
/// own. Registering a payment picks one; its account fills the "bank" role.
model T_M_ACC_CASHBANK {
  cashbank_id    Int             @id @default(autoincrement())
  company_id     Int
  journal_code   String          @db.VarChar(10)
  name           String          @db.VarChar(100)
  kind           AccCashbankKind
  account_id     Int
  bank_name      String?         @db.VarChar(100)
  account_number String?         @db.VarChar(40)
  currency_code  String          @default("IDR") @db.Char(3)
  is_active      Boolean         @default(true)

  statements T_L_ACC_BANK_STATEMENT[]

  @@unique([company_id, journal_code], map: "uq_acc_cashbank_journal")
}

enum AccTaxKind {
  output
  input
  withholding_prepaid
  withholding_payable
  final
}

/// Effective-dated tax codes. A rate is num/den so 12% x 11/12 is exact
/// (132/1200). Never hard-code a rate; values-to-verify.md says which rows are
/// settled. role_key is the account-determination key the amount posts to.
model T_M_ACC_TAX_CODE {
  tax_code_id    Int        @id @default(autoincrement())
  company_id     Int
  code           String     @db.VarChar(20)
  kind           AccTaxKind
  rate_num       Int
  rate_den       Int
  role_key       String     @db.VarChar(50)
  effective_from DateTime   @db.Date
  effective_to   DateTime?  @db.Date
  legal_basis    String?    @db.VarChar(150)
  /// verified, secondary, unverified: copied from values-to-verify.md
  status         String     @db.VarChar(20)

  @@unique([company_id, code, effective_from], map: "uq_acc_tax_code")
}

/// Payroll parameters, editable by an admin: BPJS rates and caps, PTKP, TER
/// tables, Pasal 17 brackets. One row per key per effective date; a change is
/// a new row with a later effective_from, never an edit of an old one.
/// param_key is a dotted path ("bpjs.jp_cap", "ter.A"), param_value is JSON.
/// payroll-calc.mjs setsFromRows + resolveParams turn the rows into parameters.
model T_M_ACC_PAYROLL_PARAM {
  payroll_param_id Int      @id @default(autoincrement())
  company_id       Int
  param_key        String   @db.VarChar(50)
  param_value      String   @db.Text
  effective_from   DateTime @db.Date
  legal_basis      String?  @db.VarChar(150)
  /// verified, secondary, unverified, conflict: copied from values-to-verify.md
  status           String   @db.VarChar(20)
  updated_by       Int?
  updated_at       DateTime @default(now()) @updatedAt

  @@unique([company_id, param_key, effective_from], map: "uq_acc_payroll_param")
}

/// A payment matched to an invoice on a control account, in part or whole.
/// Open items are the control-account lines less their allocations, so the
/// subledger always ties to the GL (rule 8). Undoing a match sets undone_at;
/// the row stays.
model T_L_ACC_ALLOCATION {
  allocation_id  BigInt    @id @default(autoincrement())
  company_id     Int
  debit_line_id  BigInt
  credit_line_id BigInt
  amount         Decimal   @db.Decimal(18, 2)
  allocated_at   DateTime  @default(now()) @db.Timestamp(0)
  allocated_by   Int
  undone_at      DateTime? @db.Timestamp(0)

  debit_line  T_L_ACC_JOURNAL_LINE @relation("alloc_debit", fields: [debit_line_id], references: [line_id])
  credit_line T_L_ACC_JOURNAL_LINE @relation("alloc_credit", fields: [credit_line_id], references: [line_id])

  @@index([debit_line_id], map: "ix_acc_alloc_debit")
  @@index([credit_line_id], map: "ix_acc_alloc_credit")
}

model T_L_ACC_BANK_STATEMENT {
  statement_id    BigInt   @id @default(autoincrement())
  cashbank_id     Int
  statement_date  DateTime @db.Date
  closing_balance Decimal  @db.Decimal(18, 2)
  created_by      Int
  created_at      DateTime @default(now()) @db.Timestamp(0)

  cashbank T_M_ACC_CASHBANK     @relation(fields: [cashbank_id], references: [cashbank_id])
  matches  T_L_ACC_BANK_RECON[]

  @@unique([cashbank_id, statement_date], map: "uq_acc_statement")
}

/// A ledger line matched to a bank statement. A record beside the ledger: the
/// posted line itself is never touched.
model T_L_ACC_BANK_RECON {
  line_id      BigInt   @id
  statement_id BigInt
  matched_by   Int
  matched_at   DateTime @default(now()) @db.Timestamp(0)

  line      T_L_ACC_JOURNAL_LINE   @relation(fields: [line_id], references: [line_id])
  statement T_L_ACC_BANK_STATEMENT @relation(fields: [statement_id], references: [statement_id])
}

enum AccRequestStatus {
  pending
  posted
  failed
}

/// The outbox between a module and the ledger. The module writes this row in
/// its own transaction, next to its own document; a worker posts it. A crash
/// in between loses nothing and posts nothing twice (idempotency_key).
model T_L_ACC_POSTING_REQUEST {
  request_id      BigInt           @id @default(autoincrement())
  company_id      Int
  idempotency_key String           @db.VarChar(80)
  event_type      String           @db.VarChar(50)
  source_type     String           @db.VarChar(40)
  source_id       String           @db.VarChar(40)
  /// the posting request as JSON: amounts by role, dates, party, dimensions
  payload         String           @db.LongText
  status          AccRequestStatus @default(pending)
  attempts        Int              @default(0)
  last_error      String?          @db.Text
  entry_id        BigInt?
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  posted_at       DateTime?        @db.Timestamp(0)

  @@unique([company_id, idempotency_key], map: "uq_acc_request_idem")
  @@index([status, created_at], map: "ix_acc_request_queue")
}

enum AccAssetStatus {
  active
  disposed
  cancelled
}

/// The fixed-asset register; cost and accumulated depreciation by class must
/// equal the GL (rule 8). fiscal_group is the tax depreciation group, kept
/// beside the book life because the two differ (F2).
model T_M_ACC_FIXED_ASSET {
  asset_id           Int            @id @default(autoincrement())
  company_id         Int
  asset_code         String         @db.VarChar(30)
  name               String         @db.VarChar(150)
  asset_class        String         @db.VarChar(50)
  acquisition_date   DateTime       @db.Date
  cost               Decimal        @db.Decimal(18, 2)
  residual_value     Decimal        @default(0) @db.Decimal(18, 2)
  useful_life_months Int
  fiscal_group       String?        @db.VarChar(20)
  asset_account_id   Int
  accum_account_id   Int
  expense_account_id Int
  status             AccAssetStatus @default(active)
  disposal_date      DateTime?      @db.Date
  source_entry_id    BigInt?

  @@unique([company_id, asset_code], map: "uq_acc_asset_code")
}
